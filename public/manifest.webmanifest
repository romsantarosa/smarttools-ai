{
  "name": "BTP SmartTools AI",
  "short_name": "BTP SmartTools",
  "description": "Aplicação operacional para BTP com navegação responsiva, importação automática e suporte a uso offline.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "orientation": "portrait-primary",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "sharedFiles",
          "accept": [
            "application/pdf",
            "image/png",
            "image/jpeg",
            "text/plain",
            "text/csv"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icons/app-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable any"
    }
  ]
}