rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfis de usuário (login/role). Qualquer usuário autenticado pode ler
    // (necessário para exibir nomes/times), mas só pode escrever no PRÓPRIO
    // documento. O campo `role` nunca pode ser definido diretamente pelo
    // usuário via escrita no cliente:
    //  - Criação de documento novo: `role` é sempre forçado para 'Operador'.
    //  - Atualização de documento existente: `role` não pode ser alterado
    //    (precisa continuar igual ao valor já salvo).
    // Isso fecha a auto-promoção a Supervisor mesmo que algum bug no
    // front-end tente enviar um role diferente.
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'Operador';

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    match /usuarios/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'Operador';

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // Dados operacionais compartilhados entre a equipe (navios, ferramentas,
    // manutenções, compras, relatórios, configurações, atualizações de
    // berço/turno). Exigem apenas usuário autenticado — não são dados
    // pessoais de um único usuário, são compartilhados pela operação toda,
    // então qualquer Operador ou Supervisor logado pode ler/escrever.
    match /ships_btp/{docId} {
      allow read, write: if request.auth != null;
    }

    match /ferramentas/{docId} {
      allow read, write: if request.auth != null;
    }

    match /manutencoes/{docId} {
      allow read, write: if request.auth != null;
    }

    match /compras/{docId} {
      allow read, write: if request.auth != null;
    }

    match /relatorios/{docId} {
      allow read, write: if request.auth != null;
    }

    match /configuracoes/{docId} {
      allow read, write: if request.auth != null;
    }

    match /berth_turn_updates/{docId} {
      allow read, write: if request.auth != null;
    }

    // Qualquer coleção não listada explicitamente acima fica bloqueada por
    // padrão — mais seguro exigir que toda nova coleção seja adicionada aqui
    // conscientemente do que herdar acesso aberto por omissão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}